# Reverse proxy for production + staging, sharing this ONE Caddy instance
# (only one process can bind host :80/:443, so two domains -> one Caddy,
# routed by SNI). Caddy provisions and renews a separate TLS certificate
# per domain automatically (ACME/Let's Encrypt) as long as DNS for each
# points at this VM and ports 80/443 are reachable from the internet.
#
# your-personas-stg.duckdns.org must be registered as its OWN DuckDNS name
# pointing at this VM's IP — DuckDNS only supports flat <name>.duckdns.org
# entries, NOT arbitrary subdomains of an existing one, so
# "stg.your-personas.duckdns.org" would NOT work here.
#
# TRUSTED_PROXIES in .env/.env.staging must include this container's
# address on the relevant compose network (see docker-compose.prod.yml /
# docker-compose.staging.yml) so the Go app's ParseTrustedProxies
# trusts the X-Forwarded-For header Caddy sets below —
# otherwise c.RealIP() sees Caddy's IP for every request, breaking per-IP
# rate limiting and Turnstile's remoteip. See
# docs/deploy_runbook.md for the production value; staging uses the
# `shared` network's subnet instead (172.30.0.0/16) since that's the
# network Caddy actually reaches api-staging over.

# ---------------------------------------------------------------------------
# Security headers — PRD §290 mandates these "di reverse proxy/CDN level" and
# they had never actually been implemented (verified 2026-08-30: not one of
# them was present on any of the four domains). Applied here rather than in
# each app so one file covers both the Go API and the Next.js front-ends, and
# so changing them needs no application rebuild.
# ---------------------------------------------------------------------------
(security_headers) {
	header {
		# HSTS is sticky — once a browser sees this it refuses plain HTTP for
		# the domain for a year. Safe here: Caddy already redirects 80 -> 443.
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
		# Next.js advertises itself; no reason to tell attackers the stack.
		-X-Powered-By
	}
}

# Front-end only. Report-Only ON PURPOSE for the first deploy: a wrong CSP
# breaks the app silently, so let the browser console report violations for a
# round of manual testing first, then rename the header to
# `Content-Security-Policy` to start enforcing.
#
#   script-src keeps 'unsafe-inline' because Next.js App Router emits inline
#   hydration scripts and there is no nonce middleware yet. That weakens the
#   XSS defence but still blocks injected EXTERNAL scripts, form hijacking
#   (form-action), framing (frame-ancestors) and <base> injection. Moving to
#   nonces is the follow-up worth doing, given refresh_token lives in
#   localStorage.
(csp_frontend) {
	header {
		Content-Security-Policy-Report-Only "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; img-src 'self' data: blob:; font-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline' https://challenges.cloudflare.com https://us-assets.i.posthog.com; connect-src 'self' https://us.i.posthog.com https://us-assets.i.posthog.com; frame-src https://challenges.cloudflare.com"
	}
}

your-personas.duckdns.org {
	import security_headers
	reverse_proxy api:8080
}

your-personas-stg.duckdns.org {
	import security_headers
	reverse_proxy api-staging:8080
}

your-personas-app.duckdns.org {
	import security_headers
	import csp_frontend
	reverse_proxy ui:3000
}

your-personas-app-stg.duckdns.org {
	import security_headers
	import csp_frontend
	reverse_proxy ui-staging:3000
}
