# Staging env template — copy to .env.staging on the VPS, fill in real values.
# Mirrors .env.example but scoped to docker-compose.staging.yml's containers
# (see that file + docker/Caddyfile for the shared-Caddy/network setup).

# --- Server ---
# Kept as "production" (not a real third enum value in the code — see
# internal/config.RequireProduction) so staging exercises the SAME security
# hardening path as prod (Secure cookies, etc.) — that's the whole point of
# a staging environment: catching what prod would actually do.
APP_ENV=production
APP_PORT=8080
SHUTDOWN_TIMEOUT=30s
APP_TIMEZONE=Asia/Jakarta

# --- Database (separate instance/volume from prod, see docker-compose.staging.yml) ---
DB_HOST=postgres-staging
DB_PORT=5432
DB_USER=your_persona_staging_admin
DB_PASSWORD=changeme-generate-a-real-random-password
DB_NAME=your_persona_staging_db
DB_SSLMODE=disable

# --- Redis (separate instance from prod) ---
REDIS_HOST=redis-staging
REDIS_PORT=6379
REDIS_PASSWORD=changeme-generate-a-real-random-password

# --- Object Storage — recommend a SEPARATE R2 bucket/prefix from prod so
# staging test data (and any accidental garbage from load-testing) never
# mixes with real user PDFs. If you don't have a second bucket yet, at
# minimum use a distinct prefix your own tooling respects.
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_USE_PATH_STYLE=true

# --- SMTP — routed to the bundled mailpit-staging container by default
# (docker-compose.staging.yml sets SMTP_HOST=mailpit-staging via
# `environment:`, overriding whatever is here) so staging NEVER emails a
# real inbox by accident. Leave as-is unless you deliberately want to test
# real delivery — then override SMTP_HOST/PORT/USER/PASSWORD for a real run.
SMTP_HOST=mailpit-staging
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=staging@yourpersonas.com

# --- Gemini API — reuse the same API key as prod is fine, but cap the daily
# budget low so a runaway test/load-test script can't burn real spend.
# Tune this number based on how much staging is actually used.
GEMINI_API_KEY=
GEMINI_MODEL=
GEMINI_MAX_CONCURRENT=10
GEMINI_DAILY_TOKEN_BUDGET=50000
GEMINI_TEMPERATURE=0.6

# --- Auth — MUST be its own secret, independent from prod's JWT_SECRET
# (see MEMORY.md 2026-07-24 for why dev/prod secret reuse was flagged as a
# gap) — generate on the VPS: openssl rand -base64 48
JWT_SECRET=changeme-generate-a-real-random-secret

# --- Worker (Asynq) ---
WORKER_PDF_CONCURRENCY=2
WORKER_IO_CONCURRENCY=8

# --- Bot Protection — dev/always-pass test key by default so staging
# testing isn't blocked by real Turnstile challenges. Swap to a real
# Turnstile site scoped to the staging domain only if you specifically want
# to test that flow end-to-end.
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# --- CORS — staging frontend origin(s) once the FE has its own staging
# deployment; localhost included for hitting this API directly from a local
# FE dev server during integration testing.
ALLOWED_ORIGINS=http://localhost:3000

# Shared network's subnet (see docker-compose.staging.yml / Caddyfile) — NOT
# the staging stack's own 172.29.0.0/16 default network. Caddy reaches
# api-staging over the `shared` network, so that's the subnet its
# connection actually originates from.
TRUSTED_PROXIES=172.30.0.0/16

# --- i18n ---
DEFAULT_LOCALE=en
